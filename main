// ==UserScript==
// @name         Netenyahu Armory — Krunker HVH
// @namespace    http://tampermonkey.net/
// @version      1.2.0
// @description  Aimbot, ESP, skeleton, chams, cached visibility checks, and FOV circle for Krunker.io.
// @match        *://krunker.io/*
// @match        *://browserfps.com/*
// @exclude      *://krunker.io/social*
// @exclude      *://krunker.io/editor*
// @grant        none
// @run-at       document-start
// @require      https://unpkg.com/three@0.150.0/build/three.min.js
// ==/UserScript==

(() => {
'use strict';

const THREE = window.THREE;
delete window.THREE;

const settings = {
    aimbotEnabled: true,
    aimbotOnRightMouse: false,
    espEnabled: true,
    espSkeleton: true,
    espBoxes: true,
    espNames: true,
    espDistance: true,
    espHealth: true,
    espWeapon: true,
    espChams: true,
    visCheck: true,
    targetInfo: true,
    fovCircle: true,
    fovRadius: 180,
    wireframe: false,
};

const keyToSetting = {
    KeyB: 'aimbotEnabled',
    KeyL: 'aimbotOnRightMouse',
    KeyJ: 'espSkeleton',
    KeyU: 'espBoxes',
    KeyI: 'espHealth',
    KeyY: 'espWeapon',
    KeyC: 'espChams',
    KeyO: 'visCheck',
    KeyP: 'fovCircle',
    KeyV: 'espEnabled',
    KeyK: 'wireframe',
};

const x = {
    consoleLog: console.log.bind(console),
    requestAnimationFrame: window.requestAnimationFrame.bind(window),
    setTimeout: window.setTimeout.bind(window),
    now: performance.now.bind(performance),
    indexOf: String.prototype.indexOf,
    reToString: RegExp.prototype.toString,
};

const VIS_CACHE_MS = 180;
const META_CACHE_MS = 750;

x.consoleLog('[Armory] Waiting to inject...');

const _call = Function.prototype.call;
Function.prototype.call = function() {
    if (this === x.reToString && x.indexOf.call(arguments[0]?.source || '', 'toString') >= 0) {
        return '/^function [a-zA-Z]+\\(\\) { \\[native code\\] }$/';
    }
    return _call.apply(this, arguments);
};

let scene = null;
const _push = Array.prototype.push;
const injectedPush = function() {
    for (let i = 0; i < arguments.length; i++) {
        const obj = arguments[i];
        if (typeof obj === 'object' && obj !== null && typeof obj.parent === 'object' && obj.parent !== null && obj.parent.type === 'Scene') {
            x.consoleLog('[Armory] Scene captured!');
            scene = obj.parent;
            Array.prototype.push = _push;
        }
    }
    return _push.apply(this, arguments);
};

const tempVector = new THREE.Vector3();
const tempOrigin = new THREE.Vector3();
const tempDir = new THREE.Vector3();
const tempObject = new THREE.Object3D();
const raycaster = new THREE.Raycaster();
const metadataCache = new WeakMap();
const visibilityCache = new WeakMap();
tempObject.rotation.order = 'YXZ';
raycaster.far = 4096;

const boxGeometry = new THREE.EdgesGeometry(new THREE.BoxGeometry(5, 15, 5).translate(0, 7.5, 0));
const chamsMaterial = new THREE.MeshBasicMaterial({
    color: 0xc83232,
    wireframe: false,
    transparent: true,
    opacity: 0.35,
    depthTest: false,
    toneMapped: false,
});

let canvas2d = null;
let ctx = null;

function createOverlay() {
    canvas2d = document.createElement('canvas');
    canvas2d.id = 'armory-overlay';
    canvas2d.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:99999;';
    document.body.appendChild(canvas2d);
    ctx = canvas2d.getContext('2d');
    const resize = () => {
        canvas2d.width = window.innerWidth;
        canvas2d.height = window.innerHeight;
    };
    resize();
    window.addEventListener('resize', resize);
}

const projectedVector = new THREE.Vector3();

function w2s(pos, cam) {
    if (!cam || !canvas2d) return null;
    projectedVector.copy(pos).project(cam);
    if (projectedVector.z < -1 || projectedVector.z > 1) return null;
    return {
        x: (projectedVector.x * canvas2d.width / 2) + canvas2d.width / 2,
        y: -(projectedVector.y * canvas2d.height / 2) + canvas2d.height / 2,
        z: projectedVector.z,
    };
}

function bone(player, part) {
    const origin = player.position;
    const map = {
        head: [0, 11, 0],
        neck: [0, 10, 0],
        chest: [0, 8, 0],
        pelvis: [0, 5, 0],
        lshoulder: [-2.5, 10, 0],
        rshoulder: [2.5, 10, 0],
        lhand: [-3, 8, 0],
        rhand: [3, 8, 0],
        lknee: [-1.5, 3, 0],
        rknee: [1.5, 3, 0],
        lfoot: [-1.5, 0, 0],
        rfoot: [1.5, 0, 0],
        feet: [0, 0, 0],
    };
    const delta = map[part] || [0, 9, 0];
    return new THREE.Vector3(origin.x + delta[0], origin.y + delta[1], origin.z + delta[2]);
}

const skeletonPairs = [
    ['head', 'neck'], ['neck', 'chest'], ['chest', 'pelvis'],
    ['neck', 'lshoulder'], ['lshoulder', 'lhand'],
    ['neck', 'rshoulder'], ['rshoulder', 'rhand'],
    ['pelvis', 'lknee'], ['lknee', 'lfoot'],
    ['pelvis', 'rknee'], ['rknee', 'rfoot'],
];

function getAimPoint(player, mode = 'head') {
    const fallback = mode === 'feet' ? bone(player, 'feet') : bone(player, 'head');
    const pivot = player?.children?.[0]?.children?.[0];
    if (!pivot?.localToWorld) return fallback;

    if (mode === 'head') {
        tempVector.set(0, 0, 0);
        pivot.localToWorld(tempVector);
        return tempVector.clone();
    }

    return fallback;
}

function projectPlayerBounds(player, cam) {
    const head = getAimPoint(player, 'head');
    const feet = getAimPoint(player, 'feet');
    const top = w2s(head, cam);
    const bottom = w2s(feet, cam);
    if (!top || !bottom) return null;

    const height = Math.max(18, Math.abs(bottom.y - top.y));
    const width = Math.max(10, height * 0.38);
    const centerX = top.x;
    const centerY = canvas2d.height / 2;
    const fovDistance = Math.hypot(centerX - canvas2d.width / 2, top.y - centerY);

    return {
        top,
        bottom,
        x: top.x - width / 2,
        y: top.y,
        width,
        height,
        fovDistance,
    };
}

function isRenderableMesh(obj) {
    return !!(obj && (obj.isMesh || obj.isSkinnedMesh) && obj.visible !== false && obj.geometry && obj.material);
}

function findPlayerMeta(player) {
    const cached = metadataCache.get(player);
    const now = x.now();
    if (cached && now - cached.time < META_CACHE_MS) return cached.value;

    const meta = { name: null, health: null, weapon: null };
    const seen = new Set();
    const queue = [player];

    while (queue.length && seen.size < 180) {
        const node = queue.shift();
        if (!node || (typeof node !== 'object' && typeof node !== 'function') || seen.has(node)) continue;
        seen.add(node);

        for (const key of Object.keys(node)) {
            const value = node[key];
            if (meta.health == null && typeof value === 'number' && /(?:hp|health)/i.test(key) && value >= 0 && value <= 250) {
                meta.health = value;
            }
            if (!meta.name && typeof value === 'string' && /(?:name|nick|alias|player)/i.test(key) && value.length >= 2 && value.length <= 24) {
                meta.name = value;
            }
            if (!meta.weapon && typeof value === 'string' && /(?:weapon|gun|class|loadout)/i.test(key) && value.length >= 2 && value.length <= 32) {
                meta.weapon = value;
            }
            if ((typeof value === 'object' || typeof value === 'function') && value && seen.size < 180) {
                queue.push(value);
            }
        }
    }

    if (!meta.name || /^(object|enemy)$/i.test(meta.name)) meta.name = 'Enemy';
    metadataCache.set(player, { time: now, value: meta });
    return meta;
}

function isDescendantOf(obj, root) {
    let current = obj;
    while (current) {
        if (current === root) return true;
        current = current.parent;
    }
    return false;
}

function gatherOccluders(rootScene, selfPlayer, enemyPlayer) {
    const occluders = [];
    rootScene.traverse(obj => {
        if (!isRenderableMesh(obj)) return;
        if (selfPlayer && isDescendantOf(obj, selfPlayer)) return;
        if (enemyPlayer && isDescendantOf(obj, enemyPlayer)) return;
        occluders.push(obj);
    });
    return occluders;
}

function computeVisibility(player, me, cam, rootScene) {
    if (!settings.visCheck || !cam || !rootScene) return true;

    const target = getAimPoint(player, 'head');
    cam.getWorldPosition(tempOrigin);
    tempDir.copy(target).sub(tempOrigin);
    const distance = tempDir.length();
    if (!distance) return true;
    tempDir.normalize();

    raycaster.set(tempOrigin, tempDir);
    raycaster.far = distance;

    const hits = raycaster.intersectObjects(gatherOccluders(rootScene, me, player), true);
    return hits.length === 0 || hits[0].distance >= distance - 0.5;
}

function getVisibility(player, me, cam, rootScene, shouldRefresh) {
    if (!settings.visCheck || !cam || !rootScene) return true;

    const now = x.now();
    const cached = visibilityCache.get(player);
    if (!shouldRefresh && cached) return cached.value;
    if (cached && now - cached.time < VIS_CACHE_MS) return cached.value;

    const value = computeVisibility(player, me, cam, rootScene);
    visibilityCache.set(player, { time: now, value });
    return value;
}

function drawBox(x0, y0, w, h, color) {
    const x1 = x0 + w;
    const y1 = y0 + h;
    const cx = Math.min(w * 0.28, 14);
    const cy = Math.min(h * 0.2, 16);

    ctx.strokeStyle = color;
    ctx.lineWidth = 1.5;
    ctx.beginPath();
    ctx.moveTo(x0, y0 + cy); ctx.lineTo(x0, y0); ctx.lineTo(x0 + cx, y0);
    ctx.moveTo(x1 - cx, y0); ctx.lineTo(x1, y0); ctx.lineTo(x1, y0 + cy);
    ctx.moveTo(x0, y1 - cy); ctx.lineTo(x0, y1); ctx.lineTo(x0 + cx, y1);
    ctx.moveTo(x1 - cx, y1); ctx.lineTo(x1, y1); ctx.lineTo(x1, y1 - cy);
    ctx.stroke();
}

function drawBar(x0, y0, w, pct, color) {
    ctx.fillStyle = 'rgba(0,0,0,0.45)';
    ctx.fillRect(x0, y0, w, 4);
    ctx.fillStyle = color;
    ctx.fillRect(x0, y0, Math.max(0, Math.min(w, w * pct)), 4);
}

function drawFovCircle() {
    if (!settings.fovCircle || !canvas2d || !ctx) return;

    const cx = canvas2d.width / 2;
    const cy = canvas2d.height / 2;
    ctx.beginPath();
    ctx.arc(cx, cy, settings.fovRadius, 0, Math.PI * 2);
    ctx.strokeStyle = 'rgba(46,213,115,0.7)';
    ctx.lineWidth = 1.25;
    ctx.stroke();
}

function draw2D(players, cam, bestTarget, frameInfo) {
    if (!ctx || !canvas2d) return;
    ctx.clearRect(0, 0, canvas2d.width, canvas2d.height);
    drawFovCircle();
    if (!settings.espEnabled || !cam) return;

    for (const player of players) {
        const info = frameInfo.get(player);
        if (!info?.bounds) continue;
        const { bounds, meta } = info;
        const color = info.isTarget ? '#2ed573' : (info.visible ? '#f1c40f' : '#c83232');
        const distLabel = `${Math.floor(info.distance)}m`;

        if (settings.espSkeleton) {
            for (const [a, b] of skeletonPairs) {
                const sa = w2s(bone(player, a), cam);
                const sb = w2s(bone(player, b), cam);
                if (!sa || !sb) continue;
                ctx.beginPath();
                ctx.moveTo(sa.x, sa.y);
                ctx.lineTo(sb.x, sb.y);
                ctx.strokeStyle = color;
                ctx.lineWidth = 1.4;
                ctx.stroke();
            }
        }

        if (settings.espBoxes) drawBox(bounds.x, bounds.y, bounds.width, bounds.height, color);

        const nameY = bounds.y - 14;
        if (settings.espNames) {
            ctx.font = 'bold 11px monospace';
            ctx.textAlign = 'center';
            ctx.fillStyle = '#000';
            ctx.fillText(meta.name, bounds.top.x + 1, nameY + 1);
            ctx.fillStyle = '#fff';
            ctx.fillText(meta.name, bounds.top.x, nameY);
        }

        const subParts = [];
        if (settings.espDistance) subParts.push(distLabel);
        if (settings.espHealth && Number.isFinite(meta.health)) subParts.push(`${Math.max(0, Math.round(meta.health))} HP`);
        if (settings.visCheck) subParts.push(info.visible ? 'VISIBLE' : 'HIDDEN');
        if (subParts.length) {
            const subLine = subParts.join(' • ');
            ctx.font = '10px monospace';
            ctx.textAlign = 'center';
            ctx.fillStyle = '#000';
            ctx.fillText(subLine, bounds.top.x + 1, bounds.y - 1);
            ctx.fillStyle = '#bbb';
            ctx.fillText(subLine, bounds.top.x, bounds.y - 2);
        }

        if (settings.espWeapon && meta.weapon) {
            ctx.font = '10px monospace';
            ctx.textAlign = 'center';
            ctx.fillStyle = '#000';
            ctx.fillText(meta.weapon, bounds.bottom.x + 1, bounds.bottom.y + 13);
            ctx.fillStyle = '#7bed9f';
            ctx.fillText(meta.weapon, bounds.bottom.x, bounds.bottom.y + 12);
        }

        if (settings.espHealth && Number.isFinite(meta.health)) {
            drawBar(bounds.x, bounds.bottom.y + 5, bounds.width, Math.max(0, Math.min(1, meta.health / 100)), '#2ed573');
        }

        ctx.beginPath();
        ctx.arc(bounds.top.x, bounds.top.y, 3, 0, Math.PI * 2);
        ctx.fillStyle = color;
        ctx.fill();
    }

    ctx.font = 'bold 13px monospace';
    ctx.textAlign = 'left';
    ctx.fillStyle = 'rgba(200,50,50,0.7)';
    ctx.fillText('Netenyahu Armory v1.2', 10, 20);

    if (settings.targetInfo) {
        const targetMeta = bestTarget ? frameInfo.get(bestTarget)?.meta : null;
        const summary = [
            `Enemies: ${players.length}`,
            `Visible: ${frameInfo.visibleCount || 0}`,
            `FOV: ${settings.fovRadius}`,
            bestTarget ? `Target: ${targetMeta?.name || 'Enemy'}` : 'Target: none',
        ].join(' | ');
        ctx.font = '11px monospace';
        ctx.fillStyle = 'rgba(255,255,255,0.85)';
        ctx.fillText(summary, 10, 38);
    }
}

function ensurePlayerBox(player) {
    if (player.box) return player.box;
    const box = new THREE.LineSegments(
        boxGeometry,
        new THREE.LineBasicMaterial({ color: 0xc83232, transparent: true, opacity: 0.9, depthTest: false, toneMapped: false })
    );
    box.frustumCulled = false;
    box.renderOrder = 9998;
    player.add(box);
    player.box = box;
    return box;
}

function setChams(player, enabled, visible) {
    player.traverse(obj => {
        if (!obj.isMesh || !obj.material) return;
        if (!obj._armoryMaterial) obj._armoryMaterial = obj.material;
        if (!obj._armoryChams) obj._armoryChams = chamsMaterial.clone();
        obj._armoryChams.color.setHex(visible ? 0xf1c40f : 0xc83232);
        obj._armoryChams.wireframe = settings.wireframe;
        obj.material = enabled ? obj._armoryChams : obj._armoryMaterial;
    });
}

let rightMouseDown = false;
let injectTimer = null;
let visibilityRoundRobin = 0;

function animate() {
    x.requestAnimationFrame(animate);

    if (!scene && !injectTimer) {
        const el = document.querySelector('#loadingBg');
        if (el && el.style.display === 'none') {
            x.consoleLog('[Armory] Inject timer started');
            injectTimer = x.setTimeout(() => {
                x.consoleLog('[Armory] Injecting...');
                Array.prototype.push = injectedPush;
            }, 2000);
        }
    }

    if (!scene || !scene.children) return;

    const players = [];
    let myPlayer = null;

    for (let i = 0; i < scene.children.length; i++) {
        const child = scene.children[i];
        if (child.type !== 'Object3D' || !child.children?.length) continue;
        const maybeCamera = child.children?.[0]?.children?.[0];
        if (maybeCamera?.type === 'PerspectiveCamera') {
            myPlayer = child;
        } else {
            players.push(child);
        }
    }

    if (!myPlayer) {
        Array.prototype.push = injectedPush;
        return;
    }

    const cam = myPlayer?.children?.[0]?.children?.[0] || null;
    const screenCenterX = canvas2d ? canvas2d.width / 2 : 0;
    const screenCenterY = canvas2d ? canvas2d.height / 2 : 0;
    let bestTarget = null;
    let bestVisibleTarget = null;
    let bestFovTarget = null;
    let bestVisibleFovTarget = null;
    let closestAny = Infinity;
    let closestVisible = Infinity;
    let closestFov = Infinity;
    let closestVisibleFov = Infinity;
    let visibleCount = 0;
    const frameInfo = new Map();

    visibilityRoundRobin += 1;

    for (let index = 0; index < players.length; index++) {
        const player = players[index];
        const box = ensurePlayerBox(player);
        if (player.position.y < -100 || (player.position.x === myPlayer.position.x && player.position.z === myPlayer.position.z)) {
            box.visible = false;
            setChams(player, false, false);
            continue;
        }

        const bounds = cam ? projectPlayerBounds(player, cam) : null;
        const distance = player.position.distanceTo(myPlayer.position);
        const screenDistance = bounds ? Math.hypot(bounds.top.x - screenCenterX, bounds.top.y - screenCenterY) : Infinity;
        const inFov = !settings.fovCircle || !bounds || screenDistance <= settings.fovRadius;
        const shouldRefreshVisibility = settings.visCheck && ((visibilityRoundRobin + index) % 3 === 0 || !visibilityCache.has(player));
        const visible = getVisibility(player, myPlayer, cam, scene, shouldRefreshVisibility);
        const meta = findPlayerMeta(player);
        const info = { bounds, visible, distance, screenDistance, inFov, meta, isTarget: false };
        frameInfo.set(player, info);
        if (visible) visibleCount += 1;

        box.visible = settings.espEnabled && settings.espBoxes;
        box.material.color.setHex(visible ? 0xf1c40f : 0xc83232);
        player.visible = settings.espEnabled || player.visible;
        setChams(player, settings.espEnabled && settings.espChams, visible);

        if (distance < closestAny) {
            closestAny = distance;
            bestTarget = player;
        }
        if (visible && distance < closestVisible) {
            closestVisible = distance;
            bestVisibleTarget = player;
        }
        if (inFov && screenDistance < closestFov) {
            closestFov = screenDistance;
            bestFovTarget = player;
        }
        if (visible && inFov && screenDistance < closestVisibleFov) {
            closestVisibleFov = screenDistance;
            bestVisibleFovTarget = player;
        }
    }

    const lockedTarget = settings.fovCircle
        ? ((settings.visCheck && bestVisibleFovTarget) || bestFovTarget || (settings.visCheck ? bestVisibleTarget : bestTarget))
        : ((settings.visCheck && bestVisibleTarget) || bestTarget);

    if (lockedTarget && frameInfo.has(lockedTarget)) frameInfo.get(lockedTarget).isTarget = true;
    frameInfo.visibleCount = visibleCount;

    draw2D(players, cam, lockedTarget, frameInfo);

    if (settings.wireframe && scene.fog) scene.fog = null;

    if (!settings.aimbotEnabled || (settings.aimbotOnRightMouse && !rightMouseDown) || !lockedTarget) return;
    if (settings.visCheck && !frameInfo.get(lockedTarget)?.visible) return;
    if (settings.fovCircle && !frameInfo.get(lockedTarget)?.inFov) return;

    tempVector.copy(getAimPoint(lockedTarget, 'head'));
    tempObject.position.copy(myPlayer.position);
    tempObject.lookAt(tempVector);

    myPlayer.children[0].rotation.x = -tempObject.rotation.x;
    myPlayer.rotation.y = tempObject.rotation.y + Math.PI;
}

function createGUI() {
    const el = document.createElement('div');
    el.innerHTML = `
<style>
.ag{position:fixed;right:12px;top:12px;z-index:999999;width:270px;font-family:'Courier New',monospace;font-size:11px;color:#ddd;user-select:none;background:rgba(12,12,18,0.95);border:1px solid rgba(200,50,50,0.4);border-radius:6px;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,0.6)}
.ah{background:linear-gradient(135deg,rgba(200,50,50,0.9),rgba(150,30,30,0.9));padding:10px 14px;display:flex;justify-content:space-between;align-items:center;cursor:pointer}
.ah span{font-weight:bold;font-size:13px;color:#fff;letter-spacing:1px}
.ah small{color:rgba(255,255,255,0.6);font-size:9px}
.ab{padding:4px 0;max-height:420px;overflow-y:auto}
.as{padding:6px 12px;font-size:9px;font-weight:bold;color:#c83232;text-transform:uppercase;letter-spacing:1.5px}
.ai{display:flex;justify-content:space-between;align-items:center;padding:5px 14px;cursor:pointer;transition:background 0.1s}
.ai:hover{background:rgba(200,50,50,0.1)}
.ai span{font-size:11px}
.aon{color:#2ed573;font-weight:bold}
.aoff{color:#ff4757;font-weight:bold}
.ab::-webkit-scrollbar{width:3px}
.ab::-webkit-scrollbar-thumb{background:#c83232;border-radius:2px}
.amsg{position:fixed;left:50%;bottom:80px;transform:translateX(-50%);background:rgba(12,12,18,0.9);border:1px solid #c83232;color:#fff;padding:6px 16px;border-radius:4px;font-family:monospace;font-size:12px;z-index:999999;animation:af 1.5s forwards;pointer-events:none}
@keyframes af{0%{opacity:1}70%{opacity:1}100%{opacity:0;display:none}}
</style>
<div class="amsg" style="display:none"></div>
<div class="ag">
<div class="ah" onclick="this.nextElementSibling.style.display=this.nextElementSibling.style.display==='none'?'':'none'">
<span>NETENYAHU ARMORY</span><small>v1.2</small>
</div>
<div class="ab"></div>
</div>`;

    const body = el.querySelector('.ab');
    const msg = el.querySelector('.amsg');

    function showMsg(name, value) {
        msg.innerText = `${name}: ${value ? 'ON' : 'OFF'}`;
        msg.style.display = 'none';
        void msg.offsetWidth;
        msg.style.display = '';
    }

    const sections = {
        'Aimbot': [['aimbotEnabled', 'Enable'], ['aimbotOnRightMouse', 'RMB Only'], ['visCheck', 'Visible Only'], ['fovCircle', 'FOV Circle']],
        'ESP': [['espEnabled', 'Enable'], ['espSkeleton', 'Skeleton'], ['espBoxes', 'Boxes'], ['espNames', 'Names'], ['espDistance', 'Distance'], ['espHealth', 'Health'], ['espWeapon', 'Weapon'], ['espChams', 'Chams']],
        'Visuals': [['targetInfo', 'Target Info'], ['wireframe', 'Wireframe']],
    };

    for (const [section, items] of Object.entries(sections)) {
        const sectionEl = document.createElement('div');
        sectionEl.className = 'as';
        sectionEl.textContent = section;
        body.appendChild(sectionEl);

        for (const [key, label] of items) {
            const row = document.createElement('div');
            row.className = 'ai';
            const nameEl = document.createElement('span');
            nameEl.textContent = label;
            const valueEl = document.createElement('span');
            const update = () => {
                valueEl.textContent = settings[key] ? 'ON' : 'OFF';
                valueEl.className = settings[key] ? 'aon' : 'aoff';
            };
            update();
            row.onclick = () => {
                settings[key] = !settings[key];
                update();
                showMsg(label, settings[key]);
            };
            row.append(nameEl, valueEl);
            body.appendChild(row);
        }
    }

    const footer = document.createElement('div');
    footer.className = 'ai';
    footer.style.cssText = 'justify-content:center;color:#444;font-size:9px;cursor:default';
    footer.textContent = 'B aim | O vis | P fov | U box | I hp | Y gun | H hide';
    body.appendChild(footer);

    return { el, showMsg };
}

function bindInput(showMsg) {
    window.addEventListener('pointerdown', event => {
        if (event.button === 2) rightMouseDown = true;
    });
    window.addEventListener('pointerup', event => {
        if (event.button === 2) rightMouseDown = false;
    });
    window.addEventListener('keyup', event => {
        if (document.activeElement?.value !== undefined) return;
        const setting = keyToSetting[event.code];
        if (setting) {
            settings[setting] = !settings[setting];
            showMsg(setting, settings[setting]);
        }
        if (event.code === 'BracketRight') {
            settings.fovRadius = Math.min(400, settings.fovRadius + 10);
            showMsg(`FOV ${settings.fovRadius}`, true);
        }
        if (event.code === 'BracketLeft') {
            settings.fovRadius = Math.max(40, settings.fovRadius - 10);
            showMsg(`FOV ${settings.fovRadius}`, true);
        }
        if (event.code === 'KeyH') {
            const gui = document.querySelector('.ag');
            if (gui) gui.style.display = gui.style.display === 'none' ? '' : 'none';
        }
    });
}

window.addEventListener('DOMContentLoaded', () => {
    x.consoleLog('[Armory] Initializing...');
    createOverlay();
    const { el, showMsg } = createGUI();
    document.body.appendChild(el);
    bindInput(showMsg);
    animate();
    x.consoleLog('[Armory] Ready — B:aim V:esp J:skel U:box I:hp Y:weapon C:chams O:vis P:fov [:less ]:more K:wire H:hide L:rmb');
});

})();
