// ==UserScript==
// @name         Netenyahu Armory — Krunker HVH
// @namespace    http://tampermonkey.net/
// @version      1.1.0
// @description  Aimbot, ESP, Tracers, Skeleton, Chams for Krunker.io. Instant lock, no smoothing, pure HVH.
// @match        *://krunker.io/*
// @match        *://browserfps.com/*
// @exclude      *://krunker.io/social*
// @exclude      *://krunker.io/editor*
// @grant        none
// @run-at       document-start
// @require      https://unpkg.com/three@0.150.0/build/three.min.js
// ==/UserScript==

(() => {
'use strict';

// Grab THREE before Krunker deletes it
const THREE = window.THREE;
delete window.THREE;

// ═══════════════════════════════════════════
// SETTINGS
// ═══════════════════════════════════════════
const settings = {
    aimbotEnabled: true,
    aimbotOnRightMouse: false,
    aimVisibleOnly: true,
    espEnabled: true,
    espLines: true,
    espSkeleton: true,
    espNames: true,
    espDistance: true,
    espChams: true,
    visCheck: true,
    gameInfo: true,
    wireframe: false,
};

const keyToSetting = {
    KeyB: 'aimbotEnabled',
    KeyL: 'aimbotOnRightMouse',
    KeyP: 'aimVisibleOnly',
    KeyV: 'espEnabled',
    KeyN: 'espLines',
    KeyJ: 'espSkeleton',
    KeyC: 'espChams',
    KeyO: 'visCheck',
    KeyI: 'gameInfo',
    KeyK: 'wireframe',
};

// ═══════════════════════════════════════════
// NATIVE CACHE (anti-tamper)
// ═══════════════════════════════════════════
const x = {
    consoleLog: console.log.bind(console),
    requestAnimationFrame: window.requestAnimationFrame.bind(window),
    setTimeout: window.setTimeout.bind(window),
    indexOf: String.prototype.indexOf,
    reToString: RegExp.prototype.toString,
};

x.consoleLog('[Armory] Waiting to inject...');

// Protect toString from detection
const _call = Function.prototype.call;
Function.prototype.call = function() {
    if (this === x.reToString && x.indexOf.call(arguments[0]?.source || '', 'toString') >= 0) {
        return '/^function [a-zA-Z]+\\(\\) { \\[native code\\] }$/';
    }
    return _call.apply(this, arguments);
};

// ═══════════════════════════════════════════
// SCENE INJECTION (Array.push proxy)
// ═══════════════════════════════════════════
let scene = null;
const _push = Array.prototype.push;

const injectedPush = function() {
    for (let i = 0; i < arguments.length; i++) {
        const obj = arguments[i];
        if (typeof obj === 'object' && obj !== null &&
            typeof obj.parent === 'object' && obj.parent !== null &&
            obj.parent.type === 'Scene') {
            x.consoleLog('[Armory] Scene captured!');
            scene = obj.parent;
            Array.prototype.push = _push;
        }
    }
    return _push.apply(this, arguments);
};

// ═══════════════════════════════════════════
// 3D OBJECTS (ESP boxes, tracers, chams)
// ═══════════════════════════════════════════
const tempVector = new THREE.Vector3();
const tempVector2 = new THREE.Vector3();
const tempVector3 = new THREE.Vector3();
const tempObject = new THREE.Object3D();
tempObject.rotation.order = 'YXZ';

const geometry = new THREE.EdgesGeometry(
    new THREE.BoxGeometry(5, 15, 5).translate(0, 7.5, 0)
);

const tracerVisibleColor = new THREE.Color(0x2ed573);
const tracerHiddenColor = new THREE.Color(0xc83232);

// RawShader: renders through walls via gl_Position.z = 1.0
const material = new THREE.RawShaderMaterial({
    vertexShader: `
        attribute vec3 position;
        attribute vec3 color;
        varying vec3 vColor;
        uniform mat4 projectionMatrix;
        uniform mat4 modelViewMatrix;
        void main() {
            vColor = color;
            gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
            gl_Position.z = 1.0;
        }
    `,
    fragmentShader: `
        precision mediump float;
        varying vec3 vColor;
        void main() {
            gl_FragColor = vec4(vColor, 1.0);
        }
    `
});

const chamsVisibleMaterial = new THREE.MeshBasicMaterial({
    color: 0x2ed573,
    wireframe: false,
    transparent: true,
    opacity: 0.2,
    depthTest: false,
    toneMapped: false,
});

const chamsHiddenMaterial = new THREE.MeshBasicMaterial({
    color: 0xc83232,
    wireframe: false,
    transparent: true,
    opacity: 0.35,
    depthTest: false,
    toneMapped: false,
});

const line = new THREE.LineSegments(new THREE.BufferGeometry(), material);
line.frustumCulled = false;
const linePositions = new THREE.BufferAttribute(new Float32Array(100 * 2 * 3), 3);
const lineColors = new THREE.BufferAttribute(new Float32Array(100 * 2 * 3), 3);
line.geometry.setAttribute('position', linePositions);
line.geometry.setAttribute('color', lineColors);

// ═══════════════════════════════════════════
// OVERLAY CANVAS (2D drawing)
// ═══════════════════════════════════════════
let canvas2d = null;
let ctx = null;

function createOverlay() {
    canvas2d = document.createElement('canvas');
    canvas2d.id = 'armory-overlay';
    canvas2d.style.cssText = 'position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:99999;';
    document.body.appendChild(canvas2d);
    ctx = canvas2d.getContext('2d');
    const resize = () => { canvas2d.width = window.innerWidth; canvas2d.height = window.innerHeight; };
    resize();
    window.addEventListener('resize', resize);
}

// ═══════════════════════════════════════════
// HELPERS
// ═══════════════════════════════════════════
const _pv = new THREE.Vector3();
const eyeOffset = new THREE.Vector3(0, 8.5, 0);
const raycaster = new THREE.Raycaster();
const rayHits = [];
const visibilityState = {
    mapMeshes: [],
    lastSceneVersion: -1,
};

function w2s(pos, cam) {
    if (!cam || !canvas2d) return null;
    _pv.copy(pos).project(cam);
    if (_pv.z > 1) return null;
    return { x: (_pv.x * canvas2d.width / 2) + canvas2d.width / 2, y: -(_pv.y * canvas2d.height / 2) + canvas2d.height / 2 };
}

function bone(p, b) {
    const o = p.position;
    const m = { head:[0,11,0], neck:[0,10,0], chest:[0,8,0], pelvis:[0,5,0],
        lshoulder:[-2.5,10,0], rshoulder:[2.5,10,0], lhand:[-3,8,0], rhand:[3,8,0],
        lknee:[-1.5,3,0], rknee:[1.5,3,0], lfoot:[-1.5,0,0], rfoot:[1.5,0,0] };
    const d = m[b] || [0,9,0];
    return new THREE.Vector3(o.x + d[0], o.y + d[1], o.z + d[2]);
}

function getPlayerHead(player) {
    tempVector2.setScalar(0);
    if (player?.children?.[0]?.children?.[0]?.localToWorld) {
        return player.children[0].children[0].localToWorld(tempVector2.clone());
    }
    return bone(player, 'head');
}

function isChildOf(root, child) {
    let cur = child;
    while (cur) {
        if (cur === root) return true;
        cur = cur.parent;
    }
    return false;
}

function rebuildMapMeshes(root, players, myPlayer) {
    const blockedParents = new Set([myPlayer, line, ...players]);
    const meshes = [];

    root.traverse(obj => {
        if (!obj?.isMesh || !obj.geometry || !obj.visible) return;
        if (obj.material?.transparent && obj.material.opacity <= 0.15) return;
        for (const blocked of blockedParents) {
            if (blocked && isChildOf(blocked, obj)) return;
        }
        meshes.push(obj);
    });

    visibilityState.mapMeshes = meshes;
    visibilityState.lastSceneVersion = root.children.length;
}

function isVisible(myPlayer, targetPlayer, camera, players) {
    if (!settings.visCheck || !camera) return true;

    if (visibilityState.lastSceneVersion !== scene.children.length || visibilityState.mapMeshes.length === 0) {
        rebuildMapMeshes(scene, players, myPlayer);
    }

    const origin = camera.getWorldPosition(tempVector2);
    const destination = getPlayerHead(targetPlayer);
    const direction = tempVector3.copy(destination).sub(origin);
    const distance = direction.length();
    if (!distance) return true;

    direction.normalize();
    raycaster.set(origin, direction);
    raycaster.far = distance - 0.35;
    rayHits.length = 0;
    raycaster.intersectObjects(visibilityState.mapMeshes, true, rayHits);
    return rayHits.length === 0;
}

function parseMatchInfo() {
    const matchCode = new URL(location.href).searchParams.get('game') || 'menu';
    const regionGuess = matchCode.includes(':') ? matchCode.split(':')[0] : (localStorage.pingRegion7 || 'unknown');
    const overlayCanvas = document.querySelector('#game-overlay');
    const miniMapCanvas = document.querySelector('#miniMapCanvas');

    return {
        matchCode,
        region: regionGuess,
        overlay: overlayCanvas ? `${overlayCanvas.width}x${overlayCanvas.height}` : 'n/a',
        minimap: miniMapCanvas ? `${miniMapCanvas.width}x${miniMapCanvas.height}` : 'n/a',
    };
}

function getPlayerLabel(player, index) {
    return player?.name || player?.alias || player?.label || `Enemy ${index + 1}`;
}

const skel = [
    ['head','neck'],['neck','chest'],['chest','pelvis'],
    ['neck','lshoulder'],['lshoulder','lhand'],
    ['neck','rshoulder'],['rshoulder','rhand'],
    ['pelvis','lknee'],['lknee','lfoot'],
    ['pelvis','rknee'],['rknee','rfoot'],
];

// ═══════════════════════════════════════════
// 2D ESP (skeleton, names, distance, game info)
// ═══════════════════════════════════════════
function draw2D(me, players, cam, target, info) {
    if (!ctx || !canvas2d) return;
    ctx.clearRect(0, 0, canvas2d.width, canvas2d.height);
    if (!settings.espEnabled || !cam) return;

    for (let index = 0; index < players.length; index++) {
        const p = players[index];
        const isTgt = target && p === target;
        const dist = p.position.distanceTo(me.position);
        const visible = p.__armoryVisible !== false;
        const col = isTgt ? '#2ed573' : (visible ? '#ffd166' : '#c83232');

        if (settings.espSkeleton) {
            for (const [a, b] of skel) {
                const sa = w2s(bone(p, a), cam);
                const sb = w2s(bone(p, b), cam);
                if (!sa || !sb) continue;
                ctx.beginPath();
                ctx.moveTo(sa.x, sa.y);
                ctx.lineTo(sb.x, sb.y);
                ctx.strokeStyle = col;
                ctx.lineWidth = visible ? 1.5 : 1;
                ctx.stroke();
            }
        }

        const hs = w2s(bone(p, 'head'), cam);
        if (!hs) continue;

        if (settings.espNames) {
            const label = `${getPlayerLabel(p, index)}${visible ? '' : ' [HIDDEN]'}`;
            ctx.font = 'bold 11px monospace';
            ctx.textAlign = 'center';
            ctx.fillStyle = '#000';
            ctx.fillText(label, hs.x + 1, hs.y - 12);
            ctx.fillStyle = isTgt ? '#2ed573' : '#eee';
            ctx.fillText(label, hs.x, hs.y - 13);
        }

        if (settings.espDistance) {
            const visTag = visible ? 'VIS' : 'X';
            ctx.font = '10px monospace';
            ctx.textAlign = 'center';
            ctx.fillStyle = '#000';
            ctx.fillText(`[${Math.floor(dist)}m|${visTag}]`, hs.x + 1, hs.y - 1);
            ctx.fillStyle = visible ? '#ffd166' : '#888';
            ctx.fillText(`[${Math.floor(dist)}m|${visTag}]`, hs.x, hs.y - 2);
        }

        ctx.beginPath();
        ctx.arc(hs.x, hs.y, 3, 0, Math.PI * 2);
        ctx.fillStyle = col;
        ctx.fill();
    }

    ctx.font = 'bold 13px monospace';
    ctx.textAlign = 'left';
    ctx.fillStyle = 'rgba(200,50,50,0.65)';
    ctx.fillText('Netenyahu Armory HVH', 10, 20);

    if (settings.gameInfo && info) {
        const rows = [
            `match: ${info.match.matchCode}`,
            `region: ${info.match.region}`,
            `players: ${info.totalPlayers} | visible: ${info.visiblePlayers}`,
            `target: ${info.targetName} | ${info.targetDistance}`,
            `target vis: ${info.targetVisible ? 'clear' : 'blocked'}`,
            `overlay: ${info.match.overlay} | minimap: ${info.match.minimap}`,
        ];

        ctx.font = '11px monospace';
        ctx.fillStyle = 'rgba(255,255,255,0.85)';
        rows.forEach((row, idx) => ctx.fillText(row, 10, 40 + idx * 15));
    }
}

// ═══════════════════════════════════════════
// MAIN LOOP
// ═══════════════════════════════════════════
let rightMouseDown = false;
let injectTimer = null;

function animate() {
    x.requestAnimationFrame(animate);

    if (!scene && !injectTimer) {
        const el = document.querySelector('#loadingBg');
        if (el && el.style.display === 'none') {
            x.consoleLog('[Armory] Inject timer started');
            injectTimer = x.setTimeout(() => {
                x.consoleLog('[Armory] Injecting...');
                Array.prototype.push = injectedPush;
            }, 2000);
        }
    }

    if (!scene || !scene.children) return;

    const players = [];
    let myPlayer;

    for (let i = 0; i < scene.children.length; i++) {
        const c = scene.children[i];
        if (c.type !== 'Object3D') continue;
        try {
            if (c.children.length > 0) {
                if (c.children[0].children[0].type === 'PerspectiveCamera') {
                    myPlayer = c;
                } else {
                    players.push(c);
                }
            }
        } catch (e) {}
    }

    if (!myPlayer) {
        Array.prototype.push = injectedPush;
        return;
    }
    if (!line.parent) myPlayer.add(line);

    let counter = 0;
    let targetPlayer = null;
    let visibleTargetPlayer = null;
    let minDist = Infinity;
    let minVisibleDist = Infinity;
    let visiblePlayers = 0;

    tempObject.matrix.copy(myPlayer.matrix).invert();
    const cam = myPlayer?.children?.[0]?.children?.[0] || null;

    for (let i = 0; i < players.length; i++) {
        const p = players[i];

        if (!p.box) {
            const b = new THREE.LineSegments(geometry, material.clone());
            b.frustumCulled = false;
            p.add(b);
            p.box = b;
        }

        if (p.position.y < -100 || (p.position.x === myPlayer.position.x && p.position.z === myPlayer.position.z)) {
            p.box.visible = false;
            p.__armoryVisible = false;
            continue;
        }

        const visible = isVisible(myPlayer, p, cam, players);
        p.__armoryVisible = visible;
        if (visible) visiblePlayers++;

        linePositions.setXYZ(counter, 0, 10, -5);
        tracerVisibleColor.toArray(lineColors.array, counter * 3);
        counter++;

        tempVector.copy(p.position);
        tempVector.y += 9;
        tempVector.applyMatrix4(tempObject.matrix);
        linePositions.setXYZ(counter, tempVector.x, tempVector.y, tempVector.z);
        (visible ? tracerVisibleColor : tracerHiddenColor).toArray(lineColors.array, counter * 3);
        counter++;

        p.visible = settings.espEnabled || p.visible;
        p.box.visible = settings.espEnabled;
        p.box.material = visible ? material : material;

        const d = p.position.distanceTo(myPlayer.position);
        if (d < minDist) {
            targetPlayer = p;
            minDist = d;
        }
        if (visible && d < minVisibleDist) {
            visibleTargetPlayer = p;
            minVisibleDist = d;
        }
    }

    if (settings.aimVisibleOnly && visibleTargetPlayer) {
        targetPlayer = visibleTargetPlayer;
        minDist = minVisibleDist;
    }

    linePositions.needsUpdate = true;
    lineColors.needsUpdate = true;
    line.geometry.setDrawRange(0, counter);
    line.visible = settings.espEnabled && settings.espLines;

    const info = {
        match: parseMatchInfo(),
        totalPlayers: players.length,
        visiblePlayers,
        targetName: targetPlayer ? getPlayerLabel(targetPlayer, players.indexOf(targetPlayer)) : 'none',
        targetDistance: targetPlayer ? `${Math.floor(minDist)}m` : 'n/a',
        targetVisible: !!targetPlayer?.__armoryVisible,
    };

    draw2D(myPlayer, players, cam, targetPlayer, info);

    if (settings.espChams) {
        for (const p of players) {
            const vis = p.__armoryVisible !== false;
            p.traverse(c => {
                if (c.isMesh && c.material) {
                    if (!c._om) c._om = c.material;
                    c.material = settings.espChams ? (vis ? chamsVisibleMaterial : chamsHiddenMaterial) : (c._om || c.material);
                }
            });
        }
    } else {
        for (const p of players) {
            p.traverse(c => {
                if (c.isMesh && c._om) c.material = c._om;
            });
        }
    }

    if (settings.wireframe && scene.fog) scene.fog = null;

    if (!settings.aimbotEnabled || (settings.aimbotOnRightMouse && !rightMouseDown) || !targetPlayer) return;
    if (settings.aimVisibleOnly && targetPlayer.__armoryVisible === false) return;

    tempVector.copy(getPlayerHead(targetPlayer));
    tempObject.position.copy(myPlayer.position).add(eyeOffset);
    tempObject.lookAt(tempVector);

    myPlayer.children[0].rotation.x = -tempObject.rotation.x;
    myPlayer.rotation.y = tempObject.rotation.y + Math.PI;
}

// ═══════════════════════════════════════════
// GUI
// ═══════════════════════════════════════════
function createGUI() {
    const el = document.createElement('div');
    el.innerHTML = `
<style>
.ag{position:fixed;right:12px;top:12px;z-index:999999;width:250px;font-family:'Courier New',monospace;font-size:11px;color:#ddd;user-select:none;background:rgba(12,12,18,0.95);border:1px solid rgba(200,50,50,0.4);border-radius:6px;overflow:hidden;box-shadow:0 8px 32px rgba(0,0,0,0.6)}
.ah{background:linear-gradient(135deg,rgba(200,50,50,0.9),rgba(150,30,30,0.9));padding:10px 14px;display:flex;justify-content:space-between;align-items:center;cursor:pointer}
.ah span{font-weight:bold;font-size:13px;color:#fff;letter-spacing:1px}
.ah small{color:rgba(255,255,255,0.5);font-size:9px}
.ab{padding:4px 0;max-height:400px;overflow-y:auto}
.as{padding:6px 12px;font-size:9px;font-weight:bold;color:#c83232;text-transform:uppercase;letter-spacing:1.5px}
.ai{display:flex;justify-content:space-between;align-items:center;padding:5px 14px;cursor:pointer;transition:background 0.1s}
.ai:hover{background:rgba(200,50,50,0.1)}
.ai span{font-size:11px}
.aon{color:#2ed573;font-weight:bold}
.aoff{color:#ff4757;font-weight:bold}
.ab::-webkit-scrollbar{width:3px}
.ab::-webkit-scrollbar-thumb{background:#c83232;border-radius:2px}
.amsg{position:fixed;left:50%;bottom:80px;transform:translateX(-50%);background:rgba(12,12,18,0.9);border:1px solid #c83232;color:#fff;padding:6px 16px;border-radius:4px;font-family:monospace;font-size:12px;z-index:999999;animation:af 1.5s forwards;pointer-events:none}
@keyframes af{0%{opacity:1}70%{opacity:1}100%{opacity:0;display:none}}
</style>
<div class="amsg" style="display:none"></div>
<div class="ag">
<div class="ah" onclick="this.nextElementSibling.style.display=this.nextElementSibling.style.display==='none'?'':'none'">
<span>NETENYAHU ARMORY</span><small>HVH</small>
</div>
<div class="ab"></div>
</div>`;

    const body = el.querySelector('.ab');
    const msg = el.querySelector('.amsg');

    function showMsg(n, v) {
        msg.innerText = n + ': ' + (v ? 'ON' : 'OFF');
        msg.style.display = 'none';
        void msg.offsetWidth;
        msg.style.display = '';
    }

    const secs = {
        'Aimbot': [['aimbotEnabled','Enable'], ['aimbotOnRightMouse','RMB Only'], ['aimVisibleOnly','Visible Only']],
        'ESP': [['espEnabled','Enable'], ['espLines','Tracers'], ['espSkeleton','Skeleton'], ['espNames','Names'], ['espDistance','Distance'], ['espChams','Chams'], ['visCheck','Vis Check']],
        'Info': [['gameInfo','Game Info']],
        'Visuals': [['wireframe','Wireframe']],
    };

    for (const [sec, items] of Object.entries(secs)) {
        const s = document.createElement('div');
        s.className = 'as';
        s.textContent = sec;
        body.appendChild(s);
        for (const [key, label] of items) {
            const row = document.createElement('div');
            row.className = 'ai';
            const nm = document.createElement('span');
            nm.textContent = label;
            const vl = document.createElement('span');
            const upd = () => {
                vl.textContent = settings[key] ? 'ON' : 'OFF';
                vl.className = settings[key] ? 'aon' : 'aoff';
            };
            upd();
            row.onclick = () => {
                settings[key] = !settings[key];
                upd();
                showMsg(label, settings[key]);
            };
            row.appendChild(nm);
            row.appendChild(vl);
            body.appendChild(row);
        }
    }

    const cr = document.createElement('div');
    cr.className = 'ai';
    cr.style.cssText = 'justify-content:center;color:#444;font-size:9px;cursor:default';
    cr.textContent = 'Netenyahu Armory HVH v1.1';
    body.appendChild(cr);

    return { el, showMsg };
}

// ═══════════════════════════════════════════
// INPUT
// ═══════════════════════════════════════════
function bindInput(showMsg) {
    window.addEventListener('pointerdown', e => { if (e.button === 2) rightMouseDown = true; });
    window.addEventListener('pointerup', e => { if (e.button === 2) rightMouseDown = false; });
    window.addEventListener('keyup', e => {
        if (document.activeElement?.value !== undefined) return;
        const s = keyToSetting[e.code];
        if (s) {
            settings[s] = !settings[s];
            showMsg(s, settings[s]);
        }
        if (e.code === 'KeyH') {
            const g = document.querySelector('.ag');
            if (g) g.style.display = g.style.display === 'none' ? '' : 'none';
        }
    });
}

// ═══════════════════════════════════════════
// INIT
// ═══════════════════════════════════════════
window.addEventListener('DOMContentLoaded', () => {
    x.consoleLog('[Armory] Initializing...');
    createOverlay();
    const { el, showMsg } = createGUI();
    document.body.appendChild(el);
    bindInput(showMsg);
    animate();
    x.consoleLog('[Armory] Ready — B:aim P:vis-aim V:esp N:lines J:skel C:chams O:vis-check I:info H:hide K:wire L:rmb');
});

})();
